{
  "appId": "com.sednium.kryptonide.legacy",
  "appName": "Kryptonide",
  "webDir": "dist",
  "android": {
    "buildOptions": {
      "keystorePath": "release.keystore",
      "keystoreAlias": "kryptonide"
    }
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "Keyboard": {
      "resize": "NONE",
      "resizeOnFullScreen": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f3f0e7"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#f3f0e7",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  },
  "server": {
    "androidScheme": "https"
  }
}
